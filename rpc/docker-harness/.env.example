# Absolute path to the locally built Beam jar.
BEAM_JAR=/absolute/path/to/grid-edge-mono/beam/app/build/libs/somewear-beam.jar

# Two distinct, currently unused Beam integration identities in the same workspace.
# Files may contain a raw API key or a Beam properties file with `api-key=...`.
CLIENT_API_KEY_FILE=/absolute/path/to/client-api-key
TARGET_API_KEY_FILE=/absolute/path/to/target-api-key

WORKSPACE_ID=22902
# Optional: set this to skip discovery in scripted shell/send commands.
TARGET_ACCOUNT_ID=

LOG_LEVEL=info
JAVA_OPTS=-Xmx512m
MAX_RESPONSE_BYTES=128
